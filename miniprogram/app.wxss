page {
  width: 100%;
  height: 100%;
  margin: 0;
  background-color: #030610;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: #F8FAFC;
  box-sizing: border-box;
}

view, text, image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  border: none;
}

button::after {
  display: none;
}

scroll-view {
  -webkit-overflow-scrolling: touch;
}

::-webkit-scrollbar {
  width: 0;
  height: 0;
  background: transparent;
}
