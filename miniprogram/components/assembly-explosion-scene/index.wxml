<xr-scene
  id="xrScene"
  class="scene"
  bind:ready="handleSceneReady"
  bind:log="handleSceneLog"
>
  <xr-assets
    bind:progress="handleAssetsProgress"
    bind:loaded="handleAssetsLoaded"
    bind:error="handleAssetsError"
  >
    <xr-asset-post-process asset-id="assembly-fxaa" type="fxaa" />
    <xr-asset-load
      wx:for="{{parts}}"
      wx:key="id"
      type="gltf"
      asset-id="{{item.assetId}}"
      src="{{item.modelSrc}}"
      options="ignoreError: -1"
    />
  </xr-assets>

  <xr-node node-id="assembly-root">
    <xr-gltf
      wx:for="{{parts}}"
      wx:key="id"
      id="demo-{{item.id}}"
      model="{{item.assetId}}"
      position="{{item.positionText}}"
      rotation="{{item.rotationText}}"
      scale="{{item.scale}} {{item.scale}} {{item.scale}}"
      data-part-id="{{item.id}}"
      bind:gltf-loaded="handleGltfLoaded"
      bind:gltf-error="handleGltfError"
    />
  </xr-node>

  <xr-node node-id="look-target" position="0 0.05 0"></xr-node>
  <xr-mesh
    geometry="plane"
    position="0 -1.08 0"
    rotation="-90 0 0"
    scale="4.5 4.5 4.5"
    uniforms="u_baseColorFactor:0.035 0.065 0.13 1"
  />

  <xr-camera
    id="camera"
    node-id="camera"
    position="0.12 0.22 2.7"
    target="look-target"
    near="0.01"
    far="100"
    clear-color="0.012 0.024 0.06 1"
    post-process="assembly-fxaa"
    camera-orbit-control
  />

  <xr-node node-id="lights">
    <xr-light type="ambient" color="0.82 0.9 1" intensity="1.15" />
    <xr-light type="directional" rotation="36 -42 0" color="1 0.87 0.7" intensity="3.2" />
    <xr-light type="directional" rotation="-28 138 0" color="0.32 0.68 1" intensity="1.8" />
  </xr-node>
</xr-scene>
