<view class="page">
  <solidworks-explosion-scene
    id="assemblyScene"
    class="xr-scene"
    width="{{renderWidth}}"
    height="{{renderHeight}}"
    style="position:fixed;left:0;top:0;z-index:1;width:{{viewWidth}}px;height:{{viewHeight}}px;"
    bind:scene-ready="handleSceneReady"
    bind:assets-progress="handleAssetsProgress"
    bind:assets-loaded="handleAssetsLoaded"
    bind:model-ready="handleModelReady"
    bind:model-error="handleModelError"
    bind:interaction-ready="handleInteractionReady"
    bind:interaction-warning="handleInteractionWarning"
    bind:animation-start="handleAnimationStart"
    bind:animation-end="handleAnimationEnd"
    bind:part-selected="handlePartSelected"
  />

  <view class="ambient-glow glow-left"></view>
  <view class="ambient-glow glow-right"></view>

  <view class="top-bar">
    <view class="back-button" hover-class="button-hover" bindtap="goBack">‹</view>
    <view class="title-group">
      <text class="eyebrow">SOLIDWORKS ASSEMBLY</text>
      <text class="title">减速器爆炸图</text>
    </view>
    <view class="demo-badge">GLB</view>
  </view>

  <view class="part-legend" wx:if="{{ready}}">
    <view class="legend-item"><view class="legend-dot orange"></view><text>{{animatedNodeCount}}个动画节点</text></view>
    <view class="legend-item"><view class="legend-dot green"></view><text>{{durationSeconds}}秒轨道</text></view>
  </view>

  <view class="state-card {{busy ? 'busy' : ''}}">
    <view class="state-icon">
      <view class="state-ring"></view>
      <view class="state-core"></view>
    </view>
    <view class="state-copy">
      <text class="state-label">{{stateLabel}}</text>
      <text class="state-hint">{{stateHint}}</text>
    </view>
  </view>

  <view class="interaction-tip" wx:if="{{ready && !busy}}">
    点击零件自动拆装 · 按住零件拖动 · 空白处旋转
  </view>

  <view class="control-panel">
    <view class="mode-grid">
      <view class="mode-button {{activeAction === 'install' ? 'active' : ''}} {{busy ? 'disabled' : ''}}" hover-class="button-hover" data-action="install" bindtap="handleModeTap">
        <view class="mode-icon install-icon"><view></view><view></view><view></view></view>
        <text class="mode-title">安装</text><text class="mode-subtitle">反向轨道</text>
      </view>
      <view class="mode-button {{activeAction === 'explode' ? 'active' : ''}} {{busy ? 'disabled' : ''}}" hover-class="button-hover" data-action="explode" bindtap="handleModeTap">
        <view class="mode-icon explode-icon"><view></view><view></view><view></view></view>
        <text class="mode-title">拆卸</text><text class="mode-subtitle">原始爆炸</text>
      </view>
      <view class="mode-button {{activeAction === 'section' ? 'active' : ''}} {{busy ? 'disabled' : ''}}" hover-class="button-hover" data-action="section" bindtap="handleModeTap">
        <view class="mode-icon section-icon"><view></view><view></view></view>
        <text class="mode-title">分层</text><text class="mode-subtitle">中段观察</text>
      </view>
      <view class="mode-button {{activeAction === 'complete' ? 'active' : ''}} {{busy ? 'disabled' : ''}}" hover-class="button-hover" data-action="complete" bindtap="handleModeTap">
        <view class="mode-icon complete-icon"><view></view></view>
        <text class="mode-title">完整</text><text class="mode-subtitle">回到起点</text>
      </view>
    </view>
    <view class="demo-note">
      {{assemblyLabel}} · {{interactivePartCount}} 个零件支持点击定位与独立拖动。
    </view>
  </view>

  <cover-view class="loading-screen" wx:if="{{loading}}">
    <cover-view class="loading-mark"><cover-view class="loading-orbit"></cover-view><cover-view class="loading-core">3D</cover-view></cover-view>
    <cover-view class="loading-title">正在加载减速器</cover-view>
    <cover-view class="loading-copy">{{loadingText}}</cover-view>
    <cover-view class="progress-track"><cover-view class="progress-value" style="width:{{progress}}%;"></cover-view></cover-view>
    <cover-view class="loading-retry" wx:if="{{loadTimedOut}}" bindtap="retryLoad">重新加载装配体</cover-view>
  </cover-view>
</view>
