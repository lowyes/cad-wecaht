@import "/pages/assembly-demo/assembly-demo.wxss";

.loading-retry {
  margin-top: 34rpx;
  padding: 20rpx 42rpx;
  border: 1rpx solid rgba(34, 211, 238, 0.72);
  border-radius: 999rpx;
  color: #e8fbff;
  background: rgba(8, 47, 73, 0.88);
  font-size: 27rpx;
}

.part-control {
  margin-bottom: 16rpx;
  display: flex;
  align-items: stretch;
  gap: 10rpx;
}

.part-control.disabled {
  opacity: .55;
}

.part-picker {
  min-width: 0;
  flex: 1;
}

.part-picker-value {
  height: 76rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(34, 211, 238, .2);
  border-radius: 20rpx;
  background: rgba(34, 211, 238, .06);
}

.part-picker-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.part-picker-kicker {
  color: #67e8f9;
  font-size: 15rpx;
  letter-spacing: 2rpx;
}

.part-picker-name {
  max-width: 270rpx;
  margin-top: 3rpx;
  overflow: hidden;
  color: #e2e8f0;
  font-size: 19rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.part-picker-arrow {
  margin-left: 8rpx;
  color: #67e8f9;
  font-size: 28rpx;
}

.part-action {
  width: 118rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(148, 163, 184, .16);
  border-radius: 20rpx;
  color: #dbeafe;
  font-size: 19rpx;
  background: rgba(255, 255, 255, .055);
}

.part-explode {
  border-color: rgba(249, 115, 22, .28);
  color: #fed7aa;
}

.part-restore {
  border-color: rgba(74, 222, 128, .25);
  color: #bbf7d0;
}

.part-action.disabled {
  opacity: .38;
}
